<mxfile host="app.diagrams.net" compressed="false"><diagram name="Fig3 HPC framework" id="fig3hpc"><mxGraphModel dx="1240" dy="1032" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1240" pageHeight="1032" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value='&lt;b style="font-size:21px"&gt;HPC Integration Framework for MOO-SWR&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=19;" vertex="1" parent="1"><mxGeometry x="8" y="4" width="1224" height="38" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=4;dashed=1;dashPattern=8 6;strokeWidth=2;strokeColor=#000000;fillColor=none;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="8" y="46" width="200" height="644" as="geometry"/></mxCell><mxCell id="c13" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=3;dashed=1;dashPattern=8 6;strokeWidth=2;strokeColor=#1F4FD6;fillColor=none;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="254" y="46" width="746" height="644" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=4;dashed=1;dashPattern=8 6;strokeWidth=2;strokeColor=#000000;fillColor=none;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="46" width="186" height="644" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b style="font-size:19px"&gt;1. Computational Challenges&lt;/b&gt;&lt;br&gt;&lt;i&gt;regrouped from Fig. 4&lt;/i&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="12" y="52" width="192" height="68" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b style="font-size:19px"&gt;2. Matched Parallelization Strategies&lt;/b&gt;&lt;br&gt;&lt;i&gt;(C&lt;i&gt;x&lt;/i&gt;) = challenges addressed; evidence from the included studies&lt;/i&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="258" y="52" width="738" height="68" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b style="font-size:19px"&gt;3. Enabled Capabilities&lt;/b&gt;&lt;br&gt;&lt;i&gt;(potential outcomes)&lt;/i&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1050" y="52" width="178" height="68" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:17px"&gt;C1&amp;nbsp; High Computational Cost&lt;/b&gt;&lt;br&gt;costly route evaluations&lt;br&gt;&lt;font color="#444444"&gt;&lt;i&gt;from Fig. 4:&lt;/i&gt;&lt;/font&gt; &lt;b&gt;&lt;font color="#B87400"&gt;C&lt;/font&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=2;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="18" y="126" width="180" height="104" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b style="font-size:17px"&gt;C2&amp;nbsp; Population Evaluation Burden&lt;/b&gt;&lt;br&gt;N&lt;sub style="font-size:17px"&gt;pop&lt;/sub&gt; × N&lt;sub style="font-size:17px"&gt;gen&lt;/sub&gt; fitness evaluations&lt;br&gt;&lt;font color="#444444"&gt;&lt;i&gt;from Fig. 4:&lt;/i&gt;&lt;/font&gt; &lt;b&gt;&lt;font color="#B87400"&gt;C&lt;/font&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=2;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="18" y="238" width="180" height="104" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b style="font-size:17px"&gt;C3&amp;nbsp; Uncertainty Workload&lt;/b&gt;&lt;br&gt;× N&lt;sub style="font-size:17px"&gt;s&lt;/sub&gt; ensemble members or scenarios&lt;br&gt;&lt;font color="#444444"&gt;&lt;i&gt;from Fig. 4:&lt;/i&gt;&lt;/font&gt; &lt;b&gt;&lt;font color="#0072B2"&gt;A&lt;/font&gt;&lt;/b&gt;, &lt;b&gt;&lt;font color="#B87400"&gt;C&lt;/font&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=2;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="18" y="350" width="180" height="104" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b style="font-size:17px"&gt;C4&amp;nbsp; Curse of Dimensionality&lt;/b&gt;&lt;br&gt;large graphs and state spaces&lt;br&gt;&lt;font color="#444444"&gt;&lt;i&gt;from Fig. 4:&lt;/i&gt;&lt;/font&gt; &lt;b&gt;&lt;font color="#007A5E"&gt;B&lt;/font&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=2;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="18" y="462" width="180" height="104" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;font-size:17px&quot;&gt;C5&amp;nbsp; Operational Time Mismatch&lt;/b&gt;&lt;br&gt;runtime vs. &lt;span style='white-space:nowrap'&gt;replanning&lt;/span&gt; windows&lt;br&gt;&lt;font color=&quot;#444444&quot;&gt;&lt;i&gt;from Fig. 4:&lt;/i&gt;&lt;/font&gt; &lt;b&gt;&lt;font color=&quot;#C0392B&quot;&gt;E&lt;/font&gt;&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=2;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="18" y="574" width="180" height="104" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b style="font-size:17px"&gt;GPU Acceleration&lt;/b&gt; &lt;i&gt;(C1, C2)&lt;/i&gt;&lt;br&gt;Data-parallel fitness evaluation and selected numerical kernels; MDP model building&lt;br&gt;&lt;font color="#3A6E00"&gt;&lt;b&gt;&amp;#9654; panels (a)–(c)&lt;/b&gt;&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=5;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="264" y="126" width="280" height="104" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=0;strokeColor=none;fillColor=#76B900;" vertex="1" parent="1"><mxGeometry x="265" y="132" width="7" height="92" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;Evidence in included studies:&lt;/b&gt; Dębski 2016a,b, 2021, 2023 (OpenCL); MPMOS 2026; Chowdhury 2022a†,b†; Li 2026† (CUDA)&lt;br&gt;&lt;font color="#A61B1B"&gt;&lt;i&gt;Not yet demonstrated in SWR:&lt;/i&gt;&lt;/font&gt; multi-GPU; measured concurrent CPU–GPU' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=8;strokeColor=#9DB5E8;strokeWidth=1;fillColor=#EEF3FC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="552" y="126" width="438" height="104" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:17px"&gt;Multi-Core Shared-Memory CPU&lt;/b&gt; &lt;i&gt;(C1, C4)&lt;/i&gt;&amp;nbsp; &lt;font color="#9A5200"&gt;&lt;b&gt;&amp;#9654; (a), (e)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Graph construction, edge evaluation, segment searches' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=5;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="264" y="238" width="280" height="104" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=0;strokeColor=none;fillColor=#F0A30A;" vertex="1" parent="1"><mxGeometry x="265" y="244" width="7" height="92" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b&gt;Evidence in included studies:&lt;/b&gt; Zyczkowski 2023 (OpenMP); OPMOS 2025 (Pthreads); Qian 2023, Li 2023 (parfor); Dębski 2016a,b, 2021 (OpenCL, CPU); Aguiar 2019† (threads)&lt;br&gt;&lt;font color="#A61B1B"&gt;&lt;i&gt;Not yet demonstrated in SWR:&lt;/i&gt;&lt;/font&gt; NUMA-aware scaling' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=8;strokeColor=#9DB5E8;strokeWidth=1;fillColor=#EEF3FC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="552" y="238" width="438" height="104" as="geometry"/></mxCell><mxCell id="c29" value='&lt;b style="font-size:17px"&gt;Distributed / Job-Level Execution&lt;/b&gt; &lt;i&gt;(C3, C5)&lt;/i&gt;&amp;nbsp; &lt;font color="#1B4F9C"&gt;&lt;b&gt;&amp;#9654; (d)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Independent routing jobs or scenarios on a cluster or multi&amp;#8209;core host' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=5;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="264" y="350" width="280" height="104" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=0;strokeColor=none;fillColor=#4A90D9;" vertex="1" parent="1"><mxGeometry x="265" y="356" width="7" height="92" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b&gt;Evidence in included studies:&lt;/b&gt; Eichhorn 2012† (MPI, 48-core chip); Ferris 2018† (cluster jobs); Wang 2019† (concurrent runs, one computer)&lt;br&gt;&lt;font color="#A61B1B"&gt;&lt;i&gt;Not yet demonstrated in SWR:&lt;/i&gt;&lt;/font&gt; MPI decomposition on a modern cluster; multi-node scaling' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=8;strokeColor=#9DB5E8;strokeWidth=1;fillColor=#EEF3FC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="552" y="350" width="438" height="104" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:17px"&gt;Population-Level Parallelism&lt;/b&gt; &lt;i&gt;(C2)&lt;/i&gt;&lt;br&gt;Concurrent fitness evaluations and variation operators' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=5;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="264" y="462" width="280" height="104" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b&gt;Evidence in included studies:&lt;/b&gt; GPU batch fitness evaluation, Li 2026†&lt;br&gt;&lt;font color="#A61B1B"&gt;&lt;i&gt;Not yet demonstrated in SWR:&lt;/i&gt;&lt;/font&gt; parallel population-based multi-objective optimizer' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=8;strokeColor=#9DB5E8;strokeWidth=1;fillColor=#EEF3FC;fontSize=17;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="552" y="462" width="438" height="104" as="geometry"/></mxCell><mxCell id="c34" value='&lt;b style="font-size:17px"&gt;Algorithm-Level Decomposition&lt;/b&gt; &lt;i&gt;(C3, C4)&lt;/i&gt;&lt;br&gt;Segment, within-DP-stage, label, scenario, or island decomposition' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=5;spacingLeft=10;" 